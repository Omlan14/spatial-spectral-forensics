# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
venv/
.venv/
env/

# ---------------------------------------------------------------------------
# Temporary / scratch (never commit)
# ---------------------------------------------------------------------------
__temp_skills_repo/
*.bak
*.tmp

# ---------------------------------------------------------------------------
# Pipeline artefacts that are regenerated from the locked config + seeds
# (src/experimental-pipeline.md, Sections 2 and 8). Kept out of version control
# so the repository stays lightweight and every number is reproducible from
# source. Source code, config, and small CSV/JSON result tables are tracked.
# ---------------------------------------------------------------------------
/data/raw/
*.parquet
/models/

# ---------------------------------------------------------------------------
# Generated progress reports for human review (regenerable)
# ---------------------------------------------------------------------------
/to_human/*
!/to_human/README.md
/data/images/

# LaTeX build by-products
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg

# Local scratch and superseded drafts (final deliverables: paper/final/, presentation/)
/$d/
results/_tmp_*
paper/submission/
/OVERVIEW.md

# Locally installed AI-agent tooling (not project content)
/.agents/
/.kilo/
.claude/skills/defensive-writer/
.roo/skills/defensive-writer/
